/*
   IAT - thème « Sombre »
   Thème sombre à fort contraste : tous les textes (menus et sous-menus compris) restent clairs sur fond sombre.

   Personnalisation : copiez ce fichier (dans themes/ ou themes/<nom>/style.qss),
   modifiez les couleurs, puis choisissez-le dans « Configuration > Thèmes disponibles »
   ou chargez-le via « Configuration > Charger un thème personnalisé ».

   Palette utilisée dans ce fichier :
     fond principal ...... #0F111A
     fond des panneaux ... #161824
     bordures ............ #2E3248
     texte ............... #E2E8F0
     accent .............. #00F5FF
     texte sur accent .... #0F111A

   Les directives ci-dessous (commentaires lus par l'application) fixent la couleur des
   icônes SVG de l'interface : icône « outils » de la barre horizontale et palette
   graphique des outils ; la seconde, celle des icônes d'un outil actif (fond accent).
   iat-icon-color: #00F5FF
   iat-icon-checked-color: #0F111A
*/

/* ---- Fenêtre et conteneurs ------------------------------------------------ */
QMainWindow, QDialog {
    background-color: #0F111A;
    color: #E2E8F0;
}

QWidget {
    background-color: #0F111A;
    color: #E2E8F0;
}

QLabel, QCheckBox, QRadioButton {
    background-color: transparent;
    color: #E2E8F0;
}

QLabel:disabled, QCheckBox:disabled, QRadioButton:disabled {
    color: #6B7280;
}

QDockWidget {
    color: #E2E8F0;
}

QDockWidget::title {
    background-color: #161824;
    color: #00F5FF;
    padding: 6px;
    font-weight: bold;
    border-bottom: 1px solid #00F5FF;
}

QGroupBox {
    color: #E2E8F0;
    font-weight: bold;
    border: 1px solid #2E3248;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #00F5FF;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #2E3248;
}

/* ---- Barre de menus et menus déroulants (sous-menus compris) -------------- */
QMenuBar {
    background-color: #161824;
    color: #E2E8F0;
    border-bottom: 1px solid #2E3248;
}

QMenuBar::item {
    background-color: transparent;
    color: #E2E8F0;
    padding: 4px 10px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #00F5FF;
    color: #0F111A;
}

QMenu {
    background-color: #161824;
    color: #E2E8F0;
    border: 1px solid #00F5FF;
    padding: 4px 0;
}

QMenu::item {
    background-color: transparent;
    color: #E2E8F0;
    padding: 5px 28px 5px 24px;
}

QMenu::item:selected {
    background-color: #00F5FF;
    color: #0F111A;
}

QMenu::item:disabled {
    color: #6B7280;
}

QMenu::separator {
    height: 1px;
    background-color: #2E3248;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 12px;
    height: 12px;
    left: 6px;
    border: 1px solid #2E3248;
    background-color: #161824;
}

QMenu::indicator:checked {
    background-color: #00F5FF;
    border: 1px solid #00F5FF;
}

/* ---- Barres d'outils et boutons ------------------------------------------ */
QToolBar {
    background-color: #161824;
    border: none;
    spacing: 4px;
    padding: 2px;
}

QToolBar::separator {
    background-color: #2E3248;
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background-color: #161824;
    color: #E2E8F0;
    border: 1px solid #00F5FF;
    border-radius: 4px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: #1F2338;
    color: #E2E8F0;
}

QToolButton:checked, QToolButton:pressed {
    background-color: #00F5FF;
    color: #0F111A;
    font-weight: bold;
}

QToolButton:disabled {
    background-color: #0F111A;
    color: #6B7280;
    border: 1px solid #2E3248;
}

QPushButton {
    background-color: #161824;
    color: #E2E8F0;
    border: 1px solid #00F5FF;
    border-radius: 4px;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: #1F2338;
    color: #E2E8F0;
}

QPushButton:checked, QPushButton:pressed {
    background-color: #00F5FF;
    color: #0F111A;
    font-weight: bold;
}

QPushButton:disabled {
    background-color: #0F111A;
    color: #6B7280;
    border: 1px solid #2E3248;
}

/* ---- Champs de saisie ----------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #161824;
    color: #E2E8F0;
    border: 1px solid #00F5FF;
    border-radius: 3px;
    padding: 2px 4px;
    min-height: 22px;
    selection-background-color: #00F5FF;
    selection-color: #0F111A;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #6B7280;
    border: 1px solid #2E3248;
}

/* Le champ de texte interne d'un champ numérique ne doit pas avoir son propre cadre. */
QAbstractSpinBox QLineEdit {
    border: none;
    background-color: transparent;
    padding: 0;
    min-height: 0;
}

/* Boutons « + » / « − » des champs numériques : zones de clic larges et visibles.
   « @icons/ » désigne le dossier des icônes de l'application ; les SVG référencés
   ainsi sont teintés automatiquement avec la couleur « iat-icon-color » du thème. */
QSpinBox, QDoubleSpinBox {
    padding-right: 22px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    background-color: #161824;
    border-left: 1px solid #2E3248;
    border-bottom: 1px solid #2E3248;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 22px;
    background-color: #161824;
    border-left: 1px solid #2E3248;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #1F2338;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #00F5FF;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(@icons/plus.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(@icons/minus.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off,
QDoubleSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:off,
QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off,
QDoubleSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:off {
    image: none;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #2E3248;
}

QComboBox::down-arrow {
    image: url(@icons/chevron_down.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #161824;
    color: #E2E8F0;
    border: 1px solid #00F5FF;
    selection-background-color: #00F5FF;
    selection-color: #0F111A;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #00F5FF;
    border-radius: 3px;
    background-color: #161824;
}

QCheckBox::indicator:checked {
    background-color: #00F5FF;
}

QCheckBox::indicator:disabled {
    border: 1px solid #2E3248;
    background-color: #0F111A;
}

/* ---- Listes, curseurs, barres de défilement ------------------------------- */
QListWidget {
    background-color: #161824;
    color: #E2E8F0;
    border: 1px solid #00F5FF;
}

QListWidget::item:selected {
    background-color: #00F5FF;
    color: #0F111A;
}

QSlider::groove:horizontal {
    background-color: #161824;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #00F5FF;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: -4px 0;
}

QScrollBar:vertical {
    background-color: #161824;
    width: 12px;
}

QScrollBar:horizontal {
    background-color: #161824;
    height: 12px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #00F5FF;
    min-height: 20px;
    min-width: 20px;
    border-radius: 4px;
}

/* ---- Barre d'état et infobulles ------------------------------------------ */
QStatusBar {
    background-color: #161824;
    color: #00F5FF;
}

QStatusBar QLabel {
    color: #00F5FF;
}

QToolTip {
    background-color: #161824;
    color: #E2E8F0;
    border: 1px solid #00F5FF;
    padding: 4px;
}
