# ===================================================================
# Configuration de l'application Image Annotation Tool (IAT)
# ===================================================================

# Environnement applicatif (production, development, test)
APP_ENV=production
APP_DEBUG=false

# Apparence : thème appliqué par défaut (fichier themes/<nom>.qss : cbi, clair, sombre)
# Les couleurs sont définies uniquement dans les thèmes ; le choix fait par
# l'utilisateur dans « Configuration > Thèmes disponibles » reste prioritaire.
APP_THEME=cbi
# Style Qt de base sous les thèmes (Fusion recommandé, sinon windows11, windowsvista…)
APP_QT_STYLE=Fusion

# Paramètres par défaut de traitement d'image
DEFAULT_PREVIEW_MAX_DIMENSION=1024
DEFAULT_EXPORT_QUALITY=95
DEFAULT_STROKE_WIDTH=3

# Harness / Feature Flags pour les nouvelles tâches en cours de développement
FEATURE_RECENT_FILES_HISTORY=true
FEATURE_TRAPEZOID_ROTATION=false
FEATURE_CORNER_RADIUS=true
FEATURE_MULTI_LOUPE=true
